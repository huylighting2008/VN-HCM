--[[ 
    AIMBOT WITH TEAM CHECK & GUI
    Tính năng mới: 
    - Team Check: Tự động bỏ qua đồng đội.
    - GUI điều khiển Team Check.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- // Cấu hình mặc định
local Settings = {
    AimbotEnabled = false,
    FOVEnabled = true,
    TeamCheck = true, -- Mặc định bật: Chỉ aim kẻ thù
    FOVRadius = 150,
    Smoothness = 0.1, 
    TargetPart = "Head" 
}

-- // Tạo vòng tròn FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.Visible = Settings.FOVEnabled

-- // Hàm tìm người chơi gần tâm màn hình nhất (Có kiểm tra Team)
local function GetClosestPlayer()
    local MaximumDistance = Settings.FOVRadius
    local Target = nil

    for _, player in pairs(Players:GetPlayers()) do
        -- 1. Kiểm tra không phải là chính mình
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            -- 2. KIỂM TRA TEAM: Nếu bật TeamCheck và cùng team thì bỏ qua
            if Settings.TeamCheck and player.Team == LocalPlayer.Team then
                continue -- Bỏ qua người này và chuyển sang người tiếp theo
            end

            -- 3. Tính toán khoảng cách đến tâm màn hình
            local ScreenPoint = Camera:WorldToScreenPoint(player.Character[Settings.TargetPart].Position)
            local MousePos = UserInputService:GetMouseLocation()
            local VectorDistance = (Vector2.new(MousePos.X, MousePos.Y) - Vector2.new(ScreenPoint.X, ScreenPoint.Y)).Magnitude

            if VectorDistance < MaximumDistance then
                MaximumDistance = VectorDistance
                Target = player
            end
        end
    end
    return Target
end

-- // Cập nhật Camera (Aimbot Logic)
RunService.RenderStepped:Connect(function()
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Position = UserInputService:GetMouseLocation()
    FOVCircle.Visible = Settings.FOVEnabled

    if Settings.AimbotEnabled then
        local Target = GetClosestPlayer()
        if Target and Target.Character and Target.Character:FindFirstChild(Settings.TargetPart) then
            local TargetPos = Target.Character[Settings.TargetPart].Position
            local LookAt = CFrame.new(Camera.CFrame.Position, TargetPos)
            Camera.CFrame = Camera.CFrame:Lerp(LookAt, Settings.Smoothness)
        end
    end
end)

-- // TẠO GUI ĐIỀU KHIỂN
