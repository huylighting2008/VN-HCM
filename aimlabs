--[[ 
    PRO AIMBOT: CLOSEST TARGET & VISIBILITY CHECK
    Tính năng nâng cao:
    - Wall Check: Không aim xuyên tường (Sử dụng Raycast).
    - Distance Priority: Ưu tiên kẻ địch ở gần người chơi nhất (3D Distance).
    - Team Check: Bỏ qua đồng đội.
    - Smoothness & FOV: Điều chỉnh mượt mà.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- // Cấu hình mặc định
local Settings = {
    AimbotEnabled = false,
    FOVEnabled = true,
    TeamCheck = true,
    WallCheck = true, -- Bật/Tắt kiểm tra vật cản (tường)
    FOVRadius = 150,
    Smoothness = 0.1, 
    TargetPart = "Head" 
}

-- // Tạo vòng tròn FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.Visible = Settings.FOVEnabled

-- // Hàm kiểm tra vật cản (Raycast)
local function IsVisible(targetPart)
    if not Settings.WallCheck then return true end -- Nếu tắt WallCheck, coi như luôn nhìn thấy

    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    
    local rayParams = RaycastParams.new()
    -- Loại bỏ chính nhân vật của mình khỏi danh sách kiểm tra để tia ray không tự chạm vào mình
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character} 
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(origin, direction, rayParams)

    -- Nếu không chạm gì hoặc chạm đúng vào nhân vật mục tiêu thì là "nhìn thấy"
    if result == nil or result.Instance:IsDescendantOf(result.Instance.Parent.Parent) then 
        -- Kiểm tra kỹ hơn: xem vật chạm phải có thuộc Character của mục tiêu không
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character and result.Instance:IsDescendantOf(player.Character) then
                return true
            end
        end
        return result == nil
    end
    return false
end

-- // Hàm tìm người chơi ưu tiên (Gần nhất & Không bị che khuất)
local function GetBestTarget()
    local BestTarget = nil
    local ShortestDistance = math.huge -- Bắt đầu với khoảng cách vô hạn

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            -- 1. Kiểm tra Team
            if Settings.TeamCheck and player.Team == LocalPlayer.Team then
                continue
            end

            local targetPart = player.Character[Settings.TargetPart]
            
            -- 2. Kiểm tra FOV (Phải nằm trong vòng tròn mới aim)
            local ScreenPoint = Camera:WorldToScreenPoint(targetPart.Position)
            local MousePos = UserInputService:GetMouseLocation()
            local VectorDistance = (Vector2.new(MousePos.X, MousePos.Y) - Vector2.new(ScreenPoint.X, ScreenPoint.Y)).Magnitude

            if VectorDistance < Settings.FOVRadius then
                -- 3. Kiểm tra vật cản (Wall Check)
                if IsVisible(targetPart) then
                    -- 4. ƯU TIÊN: Tìm người có khoảng cách 3D gần nhất với LocalPlayer
                    local WorldDistance = (LocalPlayer.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude
                    if WorldDistance < ShortestDistance then
                        ShortestDistance = WorldDistance
                        BestTarget = player
                    end
                end
            end
        end
    end
    return BestTarget
end

-- // Cập nhật Camera
RunService.RenderStepped:Connect(function()
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Position = UserInputService:GetMouseLocation()
    FOVCircle.Visible = Settings.FOVEnabled

    if Settings.AimbotEnabled then
        local Target = GetBestTarget()
        if Target and Target.Character and Target.Character:FindFirstChild(Settings.TargetPart) then
            local TargetPos = Target.Character[Settings.TargetPart].Position
            local LookAt = CFrame.new(Camera.CFrame.Position, TargetPos)
            Camera.CFrame = Camera.CFrame:Lerp(LookAt, Settings.Smoothness)
        end
    end
end)

